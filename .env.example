# ─── Google tagging ─────────────────────────────────────────
# All three are optional. With none set the site behaves exactly as before:
# no scripts load, no banner appears, and lead attribution is still captured
# and forwarded to HubSpot.

# GA4 measurement ID. Admin → Data streams → your web stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads conversion ID, including the AW- prefix.
# Google Ads → Goals → Conversions → Google tag.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Conversion label for the lead action ONLY — not the full send_to string.
# Google Ads → Goals → Conversions → your action → Tag setup → "Install the
# tag yourself". The snippet shows send_to: 'AW-123456789/AbC-D_efGh12345'.
# Everything after the slash goes here.
NEXT_PUBLIC_ADS_LEAD_CONVERSION_LABEL=AbC-D_efGh12345

# Server-side secret for the GA4 Measurement Protocol. Enables the
# `lead_submitted_server` event, which is sent from the API route and so
# survives ad blockers and tracking prevention that drop the client-side one.
# GA4 → Admin → Data streams → your stream → Measurement Protocol API secrets.
# Server-only: do NOT prefix with NEXT_PUBLIC_.
GA_MEASUREMENT_API_SECRET=


# ─── HubSpot ────────────────────────────────────────────────
# Without these, /api/contact logs the lead and returns success to the
# visitor — the lead is then only recoverable from serverless logs before
# they expire. Set them before running any traffic.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Create these as single-line text contact properties in HubSpot
# (Settings → Properties → Create property) or the values are dropped
# silently on submission:
#
#   budget_range
#   gclid                        gbraid                    wbraid
#   utm_source                   utm_medium                utm_campaign
#   utm_term                     utm_content
#   first_touch_source           first_touch_campaign
#   first_touch_landing_page     first_touch_referrer
#   first_touch_timestamp
#
# gclid is the one that matters most: it is the join key for uploading
# offline conversions back into Google Ads, which is what teaches bidding to
# chase qualified conversations instead of form fills.
